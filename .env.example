# Step 2: optional live EGX market-data HTTP adapter.
# Point this at a licensed/authorized provider or your own server-side proxy.
# Expected JSON: { observations: [...], fx: {...}, marketStatus?: "open"|"closed"|"auction" }
# Never expose provider credentials through NEXT_PUBLIC_* variables.
EGX_MARKET_DATA_URL=""
EGX_MARKET_DATA_API_KEY=""

# Free fundamentals provider
# Get a free Alpha Vantage API key from https://www.alphavantage.co/support/#api-key
# Free tier: 25 API requests/day for most datasets; verified open-source or educational projects may request unlimited access.
ALPHA_VANTAGE_API_KEY=""

# Optional Pixabay API key. Kept server-side; never expose as NEXT_PUBLIC_*.
PIXABAY_API_KEY=""
